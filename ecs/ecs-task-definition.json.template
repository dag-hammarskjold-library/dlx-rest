{
  "family": "dlx-rest-nightly-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::<account_id>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<account_id>:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "dlx-rest-nightly-cache",
      "image": "docker.io/valkey/valkey:latest",
      "cpu": 512,
      "portMappings": [],
      "essential": true,
      "command": [
        "valkey-server",
        "--replicaof",
        "no",
        "one",
        "--bind",
        "127.0.0.1",
        "--protected-mode",
        "no"
      ],
      "environment": [],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/dlx-rest-nightly",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "systemControls": []
    },
    {
      "name": "dlx-rest-nightly",
      "image": "public.ecr.aws/placeholder/placeholder:latest",
      "cpu": 1536,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "FLASK_APP",
          "value": "dlx_rest.app"
        },
        {
          "name": "DLX_REST_DEV",
          "value": "True"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "dependsOn": [
        {
          "containerName": "dlx-rest-nightly-cache",
          "condition": "START"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/dlx-rest-nightly",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "systemControls": []
    }
  ]
}